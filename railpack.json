{
  "$schema": "https://schema.railpack.com",
  "steps": {
    "install yarn": {
      "commands": ["npm install --global yarn"]
    },
    "install": {
      "commands": ["yarn install"]
    },
    "build": {
      "inputs": [{ "step": "install yarn" },{ "step": "install" }],
      "commands": ["ls", "npx expo export --platform web"]
    }
  },
  "deploy": {
    "startCommand": "npx serve -s dist -l 3002"
  }
}
